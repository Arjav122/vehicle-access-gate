# Copy to ".env" in this folder (repo root). Backend and frontend both read from here.

# --- Backend (FastAPI / Pydantic) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase: Settings → Database (direct or pooler). sslmode=require is appended automatically for *.supabase.co.
# If login returns DB errors, check for a conflicting DATABASE_URL in Windows user environment variables.
DATABASE_URL=

OPENAI_API_KEY=

JWT_SECRET_KEY=

ADMIN_EMAIL=
ADMIN_PASSWORD=

EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
# Same port as `backend/run.py` / uvicorn. Next.js rewrites `/api/*` here — wrong value → login "Internal Server Error".
API_PORT=8000
RUN_STARTUP_DB_SETUP=true
DEFAULT_TIMEZONE=Asia/Kolkata

# --- ANPR (optional; defaults shown) ---
# PLATE_DETECTOR_REPO=DavidDrill69/yolov11-license-plate-detection
# PLATE_DETECTOR_WEIGHTS=license-plate-finetune-v1n.pt
# PLATE_DETECTION_CONF=0.25
# HF_HUB_CACHE=

# --- Frontend (Next.js loads repo-root `.env` via next.config.mjs + dotenv) ---
# Empty NEXT_PUBLIC_API_URL = same-origin /api → Next rewrites → FastAPI.
NEXT_PUBLIC_API_URL=
# Optional Docker override for where the Next server proxies /api (defaults to http://127.0.0.1:${API_PORT}).
# BACKEND_INTERNAL_URL=http://api:8000
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
