# Copy to ".env" in the repo root and adjust. Every value here is a SAFE DEV DEFAULT.
# Real secrets (Supabase password, SMTP password, bot tokens) go only in your local .env,
# the hosting dashboard, or GitHub secrets — never in git.
# Phase 0 only uses a few of these; the rest are documented now so the list never drifts.

# ==================== Server (Node API) ====================

# development | test | production
NODE_ENV=development
# Address and port the API listens on (Docker sets HOST=0.0.0.0).
HOST=127.0.0.1
PORT=4000
# fatal | error | warn | info | debug | trace | silent (default: info; silent in tests)
LOG_LEVEL=info

# --- Database ---
# Local dev: the Postgres container. Use 127.0.0.1, not localhost (Windows may try IPv6 first and stall).
# Inside docker compose the server overrides the host to "postgres".
# Production (Supabase): pooled "transaction" URL, port 6543, add ?pgbouncer=true&sslmode=require
DATABASE_URL=postgresql://vehicle_access:vehicle_access@127.0.0.1:5432/vehicle_access
# Used only by `prisma migrate`. Production (Supabase): direct/session URL, port 5432, sslmode=require
DIRECT_URL=postgresql://vehicle_access:vehicle_access@127.0.0.1:5432/vehicle_access
# Tests only: a separate database whose name must end in _test (created automatically).
TEST_DATABASE_URL=postgresql://vehicle_access:vehicle_access@127.0.0.1:5432/vehicle_access_test

# --- Auth ---
# The server refuses to start with this default when NODE_ENV=production.
JWT_SECRET=dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- HTTP hardening ---
# Comma-separated browser origins allowed to call the API (dev: the Vite server). Empty in prod (one origin behind Caddy).
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Default JSON body limit in bytes (1 MiB).
MAX_REQUEST_BYTES=1048576
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
# Gate-event posts per device key per minute.
DEVICE_RATE_LIMIT=600

# --- Plates and gate events ---
# OCR confidence below this goes to the guard review queue.
PLATE_CONFIDENCE_THRESHOLD=0.80
# Max Levenshtein distance for fuzzy plate matching.
PLATE_FUZZY_MAX_DISTANCE=1
# Same plate on the same device within this window = one event.
GATE_EVENT_COOLDOWN_SECONDS=30
# captured_at more than this far in the future is rejected (422).
GATE_EVENT_MAX_CLOCK_SKEW_SECONDS=300

# --- Visits, approvals, escalation (defaults; admin can override in settings) ---
VISIT_LIMIT_GUEST_MINUTES=240
VISIT_LIMIT_DELIVERY_MINUTES=20
VISIT_LIMIT_CAB_MINUTES=10
VISIT_LIMIT_SERVICE_MINUTES=120
APPROVAL_TIMEOUT_SECONDS=180
OVERSTAY_REMINDER_MINUTES=30
OVERSTAY_ESCALATION_MINUTES=60
RECONCILIATION_STALE_HOURS=24
VISITOR_RETENTION_DAYS=90

# --- Email (dev: Mailpit catches everything at http://127.0.0.1:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Green Valley Gate <gate@example.com>"
SMTP_USER=
SMTP_PASSWORD=

# Public URL of the web app, used in email links.
PUBLIC_BASE_URL=http://127.0.0.1:5173
# Run node-cron jobs inside this server process.
RUN_JOBS=true

# --- Snapshots ---
# local | s3
SNAPSHOT_STORAGE=local
SNAPSHOT_LOCAL_DIR=./data/snapshots
SNAPSHOT_MAX_BYTES=2000000
# Only when SNAPSHOT_STORAGE=s3 (e.g. Supabase Storage S3 endpoint, private bucket).
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Telegram (stretch; leave empty to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Demo ---
# true enables GET /api/demo one-click logins and admin reset.
DEMO_MODE=false
DEMO_PASSWORD=demo-password-change-me

# ==================== Client (Vite dev server) ====================

# Where the Vite dev server proxies /api and /socket.io (compose overrides it to http://server:4000).
VITE_DEV_API_TARGET=http://127.0.0.1:4000

# ==================== ANPR edge worker (prefix ANPR_) ====================
# The worker reads these from anpr/.env (created by `npm run webcam:devices` in Phase 3).

ANPR_API_URL=http://127.0.0.1:4000
ANPR_DEVICE_KEY=
ANPR_EXIT_DEVICE_KEY=
ANPR_DETECTOR_MODEL=anpr/models/plate-detector.onnx
ANPR_DETECTOR_INPUT_SIZE=640
ANPR_DETECTOR_CONFIDENCE=0.35
ANPR_DETECTOR_IOU=0.5
ANPR_SAMPLE_FPS=5
ANPR_TRACK_GAP_SECONDS=2
ANPR_TRACK_MIN_AGREEING_READS=3
ANPR_MAX_RETRIES=4
ANPR_BUFFER_PATH=anpr/data/buffer.sqlite
ANPR_CAMERA_WIDTH=1280
ANPR_CAMERA_HEIGHT=720
ANPR_PREVIEW_PORT=8765
ANPR_OCR_CONTRAST=false
